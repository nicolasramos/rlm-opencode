  ],
  "bin": {
    "rlm-opencode-install": "install.js"
  },
  "scripts": {
    "test": "python3 tests/test_kernel.py"
  },
  "keywords": [
    "opencode",
    "plugin",
    "rlm",
    "recursive-language-model",
    "python",
    "kernel",
    "subagents",
    "context"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0"
  }
